# =============================================================================
# Wiesnauftakt – Umgebungsvariablen
# Lokal als .env.local anlegen, auf Vercel unter Settings → Environment Variables.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Projekt-URL, OHNE /rest/v1/ am Ende – die Bibliothek haengt den Pfad selbst an.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Der geheime Schluessel aus Settings → API Keys: `sb_secret_…` oder, bei
# aelteren Projekten, der JWT-Schluessel `service_role`. Beide funktionieren.
# Gehoert NIE ins Frontend und nie in ein NEXT_PUBLIC_-Feld.
# In der Datenbank ist RLS ohne Policy aktiv, der Server ist der einzige Weg
# an die Daten.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mailversand (Resend) ----------------------------------------------------
# Ohne Key laeuft die Seite weiter, es gehen nur keine Mails raus. Der
# Verwaltungslink steht dann trotzdem auf der Bestaetigungsseite.
RESEND_API_KEY=

# Verifizierte Absenderdomain, kein privates Postfach.
MAIL_ABSENDER="Wiesnauftakt <wiesn@pfarrjugend-sjb.de>"

# --- Orgabereich -------------------------------------------------------------
# Gemeinsames Passwort fuer /admin. Lang und zufaellig waehlen.
ADMIN_PASSWORT=

# Optional: eigenes Geheimnis fuer die Sitzungssignatur. Ohne diesen Wert wird
# ADMIN_PASSWORT verwendet – dann werden beim Passwortwechsel alle abgemeldet.
ADMIN_SESSION_SECRET=

# --- Adressen ----------------------------------------------------------------
# Basisadresse fuer die Links in den Mails. Auf Vercel optional, dort wird
# sonst die Deployment-URL verwendet.
NEXT_PUBLIC_SITE_URL=https://wiesnauftakt.pfarrjugend-sjb.de

# --- Wachhalter (nur noetig im kostenlosen Supabase-Tarif) -------------------
# Beliebige lange Zufallszeichenkette. Vercel schickt sie automatisch als
# Authorization-Header an /api/wachhalten, damit den Endpunkt nicht jeder
# aufrufen kann. Ohne diesen Wert ist der Endpunkt offen – er gibt allerdings
# nur zwei Zahlen zurueck.
CRON_SECRET=

# --- Nur fuer die lokale Vorschau -------------------------------------------
# Zeigt Beispieltische, solange keine Datenbank verbunden ist. In Produktion
# weglassen.
# WIESN_DEMO=1
